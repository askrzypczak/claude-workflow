<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: dispatch/install-launchd.sh fills in the clone and home paths. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.askrzypczak.claude-workflow-poller</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__CLONE__/dispatch/agent-poller.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>180</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/claude-workflow-poller.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/claude-workflow-poller.log</string>
</dict>
</plist>
