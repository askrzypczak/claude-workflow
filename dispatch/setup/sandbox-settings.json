{
  "env": {
    "CLAUDE_CODE_PLUGIN_PREFER_HTTPS": "1",
    "CLAUDE_CODE_ENABLE_CFC": "0"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "git fetch *",
      "git pull *",
      "git push *"
    ],
    "network": {
      "allowedDomains": [
        "api.github.com",
        "results-receiver.actions.githubusercontent.com",
        "registry.npmjs.org"
      ],
      "strictAllowlist": true
    },
    "credentials": {
      "files": [
        {
          "path": "~/.claude/.credentials.json",
          "mode": "deny"
        },
        {
          "path": "~/Library/Application Support/Google/Chrome",
          "mode": "deny"
        },
        {
          "path": "~/Library/Application Support/BraveSoftware",
          "mode": "deny"
        },
        {
          "path": "~/Library/Application Support/Arc",
          "mode": "deny"
        },
        {
          "path": "~/Library/Application Support/Microsoft Edge",
          "mode": "deny"
        },
        {
          "path": "~/Library/Application Support/Firefox",
          "mode": "deny"
        },
        {
          "path": "~/Library/Safari",
          "mode": "deny"
        },
        {
          "path": "~/Library/Cookies",
          "mode": "deny"
        }
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Read(~/Library/Application Support/Google/Chrome/**)",
      "Edit(~/Library/Application Support/Google/Chrome/**)",
      "Read(~/Library/Application Support/BraveSoftware/**)",
      "Edit(~/Library/Application Support/BraveSoftware/**)",
      "Read(~/Library/Application Support/Arc/**)",
      "Edit(~/Library/Application Support/Arc/**)",
      "Read(~/Library/Application Support/Microsoft Edge/**)",
      "Edit(~/Library/Application Support/Microsoft Edge/**)",
      "Read(~/Library/Application Support/Firefox/**)",
      "Edit(~/Library/Application Support/Firefox/**)",
      "Read(~/Library/Safari/**)",
      "Edit(~/Library/Safari/**)",
      "Read(~/Library/Cookies/**)",
      "Edit(~/Library/Cookies/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/**)",
      "Edit(//**/.git/hooks/**)",
      "Edit(//**/.git/config)",
      "Bash(git fetch *--upl*)",
      "Bash(git pull *--upl*)",
      "Bash(git push *--rece*)",
      "Bash(git push *--e*)"
    ]
  }
}
